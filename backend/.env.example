# Copy to ../.env (docker compose) or backend/.env (local run). Generate secrets with: python scripts/gen_keys.py
APP_ENV=production
DATABASE_URL=postgresql+psycopg2://hads:hads@db:5432/hads
JWT_SECRET=
DATA_ENCRYPTION_KEY=
CORS_ORIGINS=https://hads.example.org
ROUTING_PROVIDER=osrm
SEED_ON_STARTUP=false
DEMO_AUTOPILOT=false
# Service area and map centre (Chennai default); another city = these three settings
SERVICE_AREA=12.80,79.98,13.25,80.35
CITY_LAT=13.0827
CITY_LNG=80.2707
