# Rendered by the nginx image's envsubst step at container start (only ${STADIA_API_KEY} is substituted).
# HTTPS is switched on by docker-entrypoint.d/40-hads-tls.sh when /etc/nginx/certs/fullchain.pem exists.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Base-map tiles are proxied and cached here: repeat loads are instant and the provider key stays server-side.
# With no key, the browser's own Referer is forwarded (Stadia allows localhost); deployed domains need a key,
# otherwise the frontend falls back to OpenStreetMap tiles on its own.
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tiles:20m max_size=1g inactive=30d use_temp_path=off;

# Per-client-address cap on concurrent API connections (see nginx/app.conf: websockets and emergency intake are exempt).
limit_conn_zone $binary_remote_addr zone=hads_api_conn:10m;

map "${STADIA_API_KEY}" $stadia_args {
  ""      "";
  default "api_key=${STADIA_API_KEY}";
}

server {
  listen 80;
  server_name _;
  # Either the whole app (HTTP only) or a redirect to HTTPS, chosen at container start.
  include /etc/nginx/hads/http-mode.conf;
}
