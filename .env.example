# Production settings for docker compose. Copy to .env and fill in; generate secrets with:
#   python backend/scripts/gen_keys.py
POSTGRES_PASSWORD=
JWT_SECRET=
DATA_ENCRYPTION_KEY=
CORS_ORIGINS=https://hads.example.org
# First boot only: creates this admin when the database has no users (change the password at first sign-in).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Base-map tiles via nginx (free key at stadiamaps.com; needed on a real domain).
STADIA_API_KEY=
# HTTPS: put fullchain.pem and privkey.pem in ./certs (scripts/make-cert.* makes a self-signed pair for testing).
CERTS_DIR=./certs
HTTP_PORT=80
HTTPS_PORT=443
# Backups (docs/OPERATIONS.md): a host path on a second disk is strongly recommended, e.g. D:/hads-backups
BACKUP_DIR=
BACKUP_KEEP=7
BACKUP_INTERVAL_H=24

# Service area (lat_min,lng_min,lat_max,lng_max) and map centre; Chennai by default. Another city: set all three.
SERVICE_AREA=12.80,79.98,13.25,80.35
CITY_LAT=13.0827
CITY_LNG=80.2707
